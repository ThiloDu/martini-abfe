; General setup
integrator               = sd
dt                       = 0.02
nsteps                   = 40000
comm-mode                = Linear
; Output
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 0
nstenergy                = 0
nstxout-compressed       = 0
; Non-bonded interactions
verlet-buffer-tolerance  = -1
nstlist                  = 20
rlist                    = 1.35
coulombtype              = Reaction-Field
rcoulomb                 = 1.1
epsilon-r                = 15
epsilon-rf               = 0
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.1
periodic-molecules       = no
; Temperature control
tau-t                    = 2.0 2.0 2.0
ref-t                    = 300 300 300
tc-grps                  = other Protein ligand
nsttcouple               = 20
; Pressure control
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau-p                    = 4.0
ref-p                    = 1.0
compressibility          = 3e-4
nstpcouple               = 20
refcoord-scaling         = com
; Boundary conditions
pbc                      = xyz
; Initial velocities
gen-vel                  = yes
gen-temp                 = 300
; Constraints
lincs-order              = 8
lincs-iter               = 2
lincs-warnangle          = 90
; Group restraints
pull                     = yes
pull-nstxout             = 0
pull-nstfout             = 0
pull-ncoords             = 1
pull-ngroups             = 2
pull-group1-name         = ligand
pull-group1-pbcatom      = 382
pull-group2-name         = dummy
pull-coord1-groups       = 2 1
pull-coord1-geometry     = distance
pull-coord1-type         = umbrella
pull-coord1-k            = 2000
pull-coord1-init         = 0.0
pull-coord1-start        = no
